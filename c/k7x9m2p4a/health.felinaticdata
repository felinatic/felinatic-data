    },
    {
      "id": "ictericia",
      "displayName": "Ictericia (color amarillo)",
      "description": "Color amarillento en encías, piel de las orejas o el blanco del ojo. Indica problemas hepáticos, biliares o destrucción acelerada de glóbulos rojos. URGENCIA.",
      "category": "GENERAL",
      "urgentByItself": true
    },
    {
      "id": "dolor_abdominal",
      "displayName": "Dolor abdominal",
      "description": "Postura encogida, vientre tenso al tacto, evita ser tocado en la zona, postura de \"rezo\" (cabeza abajo, cuartos traseros levantados).",
      "category": "DIGESTIVE"
    },
    {
      "id": "tos",
