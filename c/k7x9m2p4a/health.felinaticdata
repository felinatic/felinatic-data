    },
    {
      "id": "poliuria",
      "displayName": "Orina mucho más de lo habitual",
      "description": "Mayor volumen de orina, llena el arenero más rápido o aparecen marcas más grandes. Habitualmente asociado a polidipsia.",
      "category": "URINARY"
    },
    {
      "id": "orina_fuera_arenero",
      "displayName": "Orina fuera del arenero",
      "description": "Cambia su hábito y elige otros lugares. Puede indicar dolor al orinar, cistitis, problemas urinarios o estrés. No es \"mal comportamiento\".",
      "category": "URINARY"
    },
    {
      "id": "dolor_orinar",
      "displayName": "Dolor o esfuerzo al orinar",
      "description": "Maúlla, gime o adopta postura forzada al orinar. Tiempos largos en el arenero. Sugiere cistitis, cristales o, en machos, obstrucción incipiente.",
      "category": "URINARY"
    },
    {
      "id": "estornudos",
      "displayName": "Estornudos frecuentes",
