      "category": "GENERAL"
    },
    {
      "id": "fiebre",
      "displayName": "Fiebre",
      "description": "Temperatura corporal por encima de 39,2 °C. Sólo se puede confirmar con termómetro rectal — \"al tacto\" no es fiable.",
      "category": "GENERAL"
    },
    {
      "id": "vomitos_frecuentes",
