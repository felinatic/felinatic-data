      "urgentByItself": true
    },
    {
      "id": "sacudidas_cabeza",
      "displayName": "Sacudidas de cabeza",
      "description": "El gato sacude la cabeza con frecuencia o se rasca insistentemente las orejas. Suele estar relacionado con problemas de oído, como ácaros u otitis.",
      "category": "GENERAL",
      "urgentByItself": false
    },
    {
