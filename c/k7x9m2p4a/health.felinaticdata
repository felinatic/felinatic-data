      "category": "DIGESTIVE"
    },
    {
      "id": "sangre_orina",
      "displayName": "Sangre en la orina",
      "description": "Orina rojiza, rosada o con coágulos. Puede ser señal de cistitis, cálculos urinarios o problemas renales.",
      "category": "URINARY"
    },
    {
